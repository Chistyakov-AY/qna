=render 'shared/errors', resource: @question

= form_with model: @question do |f|
  => f.label :title
  => f.text_field :title

  => f.label :body
  => f.text_area :body

  p Links
  p
    = f.fields_for :links do |l|
      p
        = l.label :name, 'Link name'
        = l.text_field :name
      p
        = l.label :url
        = l.text_field :url
  
  => f.label :files, "Your files"
  => f.file_field :files, multiple: true
  => f.submit 'Save'

p= link_to 'Back', questions_path
