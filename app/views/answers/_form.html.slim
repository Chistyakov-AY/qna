= form_with model: [@question, @answer], multipart: true, local: false do |f|
  => f.label :body, "Your answer"
  = f.text_area :body
  br =

  = f.label :files, "Files:"

  p Links:
  p
    = f.fields_for :links do |l|
      p
        = l.label :name, 'Link name'
        = l.text_field :name
      p
        = l.label :url
        = l.text_field :url

  = f.file_field :files, multiple: true, direct_upload: true

  = f.submit 'Create answer'
  